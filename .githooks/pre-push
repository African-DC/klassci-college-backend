#!/bin/sh
# Ce qui ne doit jamais etre pousse.
set -e

refus() {
  printf '\n\033[31mPush refuse\033[0m — %s\n\n' "$1" >&2
  shift
  for ligne in "$@"; do printf '  %s\n' "$ligne" >&2; done
  printf '\n  Passer outre (a eviter) : git push --no-verify\n\n' >&2
  exit 1
}

branche=$(git rev-parse --abbrev-ref HEAD)

# --- 1. Jamais de push direct sur les branches partagees ----------------------
case "$branche" in
  main|develop|staging)
    refus "on ne pousse pas directement sur « $branche »." \
      "Le chemin est : branche -> PR vers develop -> PR develop vers main."
    ;;
esac

# --- 2. Le nom de branche que la CI exige -------------------------------------
# `Validate Branch Name` refuse deja ce qui suit ; le dire ici epargne un
# aller-retour de CI et une PR a rouvrir, ce qui est arrive.
if ! printf '%s' "$branche" | grep -qE '^((feature|fix|hotfix|refactor|test)/[0-9]+-[a-z0-9-]+|chore/[a-z0-9-]+|dependabot/.+)$'; then
  refus "le nom de branche « $branche » sera refuse par la CI." \
    "Attendu : feature/42-description, fix/42-description, hotfix/42-...," \
    "          refactor/42-..., test/42-..., ou chore/description (sans numero)." \
    "Le numero est celui d'une issue GitHub : ouvrez-la d'abord."
fi

exit 0
