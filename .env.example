# KLASSCI Collège — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Application
APP_ENV=development
DEBUG=true

# Database — {tenant} est remplacé dynamiquement par le TenantMiddleware
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/{tenant}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — générer avec : openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KLASSCI College

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Tenant local (dev uniquement)
LOCAL_TENANT_ID=local
