# Base de données (MySQL 8)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/klassci_master

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environnement
ENVIRONMENT=development

# DigitalOcean Spaces (stockage fichiers, bulletins PDF)
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_BUCKET=klassci-dev
DO_SPACES_REGION=fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Puppeteer microservice (génération PDF bulletins)
PDF_SERVICE_URL=http://localhost:3001

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
