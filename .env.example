# KLASSCI Collège — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Application
APP_ENV=development
DEBUG=true

# Database — {tenant} est remplacé dynamiquement par le TenantMiddleware
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/{tenant}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — générer avec : openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sceau numérique institutionnel KLASSCI
# Installer la paire partagée : py scripts/provision_document_seal_env.py --env-file .env --key-file document-seal.env
DOCUMENT_SEAL_ACTIVE_KEY_ID=klassci-college-2026-01
DOCUMENT_SEAL_PRIVATE_KEY_B64=
# Conserver ici les anciennes clés publiques après rotation.
DOCUMENT_SEAL_PUBLIC_KEYS_JSON={}
# Copier ici la SECRET_KEY historique avant toute rotation JWT.
DOCUMENT_SEAL_LEGACY_SECRET_KEY=
DOCUMENT_SEAL_DEFAULT_VALIDITY_DAYS=365

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Host allowlist — protection CSRF / host header injection
# Pattern regex matchant les hôtes acceptés en prod. Localhost + IPs locales
# sont toujours acceptés (dev) en plus de ce pattern.
# Default = sous-domaines KLASSCI College : <tenant>.college.klassci.com
ALLOWED_HOST_PATTERN=^[a-z0-9][a-z0-9\-]{0,61}\.college\.klassci\.com$
# Liste explicite supplémentaire si besoin (JSON array) — ex: ["api.college.klassci.com"]
EXTRA_ALLOWED_HOSTS=[]

# SMTP (Resend recommandé — free tier 3000 emails/mois)
# Setup : https://resend.com → API Keys → DKIM/SPF DNS records pour klassci.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@klassci.com
SMTP_FROM_NAME=KLASSCI College

# Sentry (observabilité — no-op si SENTRY_DSN vide)
# Setup : https://sentry.io → New Project (Python/FastAPI) → copy DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
APP_VERSION=0.1.0-alpha

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Racine des fichiers téléversés (photos, signatures, logos, documents),
# servie sous /uploads. Doit pointer sur un stockage persistant : en Docker,
# le volume monté sur /app/uploads. Jamais un dossier temporaire, il est vidé
# à chaque recréation du conteneur, donc les photos disparaissent.
UPLOAD_ROOT=/app/uploads

# Tenant local (dev uniquement)
LOCAL_TENANT_ID=local

# Racine du SAS de depot par telephone. Separee d'UPLOAD_ROOT, et ce n'est pas
# du rangement : UPLOAD_ROOT est servi en fichiers statiques, sans
# authentification ni cloisonnement d'etablissement. Une photo de mineur en
# attente de validation y serait publique.
HANDOFF_ROOT=/app/handoff

# L'adresse que porte le code QR, donc celle que le TELEPHONE doit atteindre.
# L'ordinateur est sur le reseau de l'ecole, le telephone sur sa donnee mobile :
# une adresse interne ne s'ouvrirait pas. Sur un serveur de demonstration, la
# renseigner explicitement — sinon le QR pointe vers la production, avec un
# jeton qui n'y existe pas.
PUBLIC_BASE_URL=https://college.klassci.com
