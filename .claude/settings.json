{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(alembic *)",
      "Bash(uvicorn *)",
      "Bash(pip install *)",
      "Bash(pip list)",
      "Read(**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push origin main)",
      "Bash(git push origin staging)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(alembic downgrade *)"
    ]
  }
}
