[Unit]
Description=KLASSCI College — Test hebdomadaire de restauration backup
Documentation=file:/home/ubuntu/klassci/klassci-backend/scripts/README.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/klassci/backup.env
ExecStart=/home/ubuntu/klassci/klassci-backend/scripts/restore-test.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klassci-restore-test

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /var/tmp

MemoryMax=1G
TasksMax=64
