[Unit]
Description=KLASSCI College — Restore-test hebdomadaire des backups
Documentation=file:%h/klassci-backend/scripts/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-%h/klassci-backup.env
ExecStart=%h/klassci-backend/scripts/restore-test.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klassci-restore-test

# Protection systemd (relaxée pour permettre docker exec)
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/klassci-backups /tmp /var/tmp

# Limite ressources
MemoryMax=1G
TasksMax=64
TimeoutStartSec=1800
