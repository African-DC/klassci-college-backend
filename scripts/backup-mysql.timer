[Unit]
# Unité UTILISATEUR, comme le service qu'elle déclenche.
Description=KLASSCI College — Sauvegarde quotidienne à 02:30 UTC
Documentation=file:%h/klassci-backend/scripts/README.md

[Timer]
# 02:30 et non 02:00 : la sauvegarde de l'autre application du même serveur
# tourne à 02:15, et deux dumps simultanés se disputeraient le disque.
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
