[Unit]
Description=KLASSCI College Backend (FastAPI/uvicorn)
Documentation=https://github.com/African-DC/klassci-college-backend
After=network.target docker.service
Wants=docker.service
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/klassci/klassci-backend
EnvironmentFile=/home/ubuntu/klassci/klassci-backend/.env
# Ensure the uploads dir exists before the process starts. /tmp is volatile on
# reboot and ReadWritePaths refuses to bind a missing path. PermissionsStartOnly
# legacy is replaced by '+' prefix which lets the command run as root.
ExecStartPre=+/usr/bin/install -d -m 0755 -o ubuntu -g ubuntu /tmp/klassci-uploads
ExecStart=/home/ubuntu/klassci/klassci-backend/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8000 \
    --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klassci-backend

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=false
ReadWritePaths=/tmp/klassci-uploads /home/ubuntu/klassci/klassci-backend

[Install]
WantedBy=multi-user.target
