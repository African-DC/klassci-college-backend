[Unit]
Description=KLASSCI College — Backup MySQL multi-tenant
Documentation=file:/home/ubuntu/klassci/klassci-backend/scripts/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/etc/klassci/backup.env
ExecStartPre=+/usr/bin/install -d -o ubuntu -g ubuntu -m 0755 /home/ubuntu/klassci/backups
ExecStart=/home/ubuntu/klassci/klassci-backend/scripts/backup-mysql.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klassci-backup

# Protection systemd (relaxée pour permettre docker exec + écriture local backup dir)
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/klassci/backups /tmp /var/tmp

# Limite ressources
MemoryMax=512M
TasksMax=64
TimeoutStartSec=1800
