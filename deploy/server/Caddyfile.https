{
	admin off
	email adcdevteam2025@gmail.com
}

# --- Domaine principal avec HTTPS auto (Let's Encrypt) ---
college.klassci.com {
	encode gzip zstd

	@svc path /svc/*
	handle @svc {
		uri strip_prefix /svc
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# --- Evolution API (passerelle WhatsApp), sur son propre sous-domaine ---
# Ne pas la ranger sous college.klassci.com/evolution : ce domaine a déménagé
# sur le serveur de production (Dokploy), alors qu'Evolution tourne ici, sur
# 127.0.0.1:8080. Le port 8080 ne doit jamais être ouvert : seul Caddy l'expose,
# en HTTPS, parce que la clé d'API circule dans chaque requête.
evolution.klassci.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# --- Accès direct par IP (HTTP, pas de certificat possible sur une IP) ---
http://94.72.96.119 {
	encode gzip zstd

	@svc path /svc/*
	handle @svc {
		uri strip_prefix /svc
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
