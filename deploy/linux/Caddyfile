{
	admin off
}

:80 {
	encode gzip zstd

	@svc path /svc/*
	handle @svc {
		uri strip_prefix /svc
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
